# ==============================================================================
# SCHOLARSHIP AI SERVICE - BIẾN MÔI TRƯỜNG MẪU
# ==============================================================================

PROJECT_NAME="Scholarship AI Service"
VERSION="1.0.0"
PORT=7782

# 1. Bảo mật API nội bộ
API_KEY="scholarship_internal_secret_key"

# 2. Cơ sở dữ liệu PostgreSQL / Supabase có tích hợp pgvector
# Định dạng: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=scholarship_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# 3. Cấu hình LLM (Hỗ trợ Google Gemini, OpenAI, OpenRouter hoặc Local Ollama/vLLM)
# Tùy chọn 1: Google Gemini (Khuyến nghị: Miễn phí & Rất nhanh)
LLM_PROVIDER="google"
LLM_MODEL="gemini-2.0-flash-lite"
GEMINI_API_KEY="AIzaSy..."

# Tùy chọn 2: OpenAI / OpenRouter
# LLM_PROVIDER="openai"
# LLM_BASE_URL="https://api.openai.com/v1"
# OPENAI_API_KEY="sk-..."
# LLM_MODEL="gpt-4o-mini"

# Tùy chọn 3: OpenRouter
# LLM_PROVIDER="openrouter"
# OPENROUTER_API_KEY="sk-or-..."
# LLM_BASE_URL="https://openrouter.ai/api/v1"
# LLM_MODEL="google/gemini-2.5-flash-lite"

# 4. Kích thước Vector Embedding (Mặc định 1024 cho BGE-M3 / Gemini text-embedding-004, hoặc 1536 cho OpenAI)
EMBEDDING_DIM=1024
